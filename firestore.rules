rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if true; // Permissive rule for development mode & applet usage
    }

    match /calon_siswa/{id} {
      allow read, write: if true;
    }

    match /hasil_kesehatan/{id} {
      allow read, write: if true;
    }

    match /asesmen_disc/{id} {
      allow read, write: if true;
    }

    match /asesmen_psikotes/{id} {
      allow read, write: if true;
    }

    match /dukungan_dana/{id} {
      allow read, write: if true;
    }

    match /surat_perjanjian/{id} {
      allow read, write: if true;
    }

    match /crm_leads/{id} {
      allow read, write: if true;
    }

    match /mitra_organizations/{id} {
      allow read, write: if true;
    }

    match /admin_users/{id} {
      allow read, write: if true;
    }

    match /pengaturan_master/{id} {
      allow read, write: if true;
    }

    match /lowongan_kerja/{id} {
      allow read, write: if true;
    }

    match /lamaran_kerja/{id} {
      allow read, write: if true;
    }

    match /candidates/{id} {
      allow read, write: if true;
    }
  }
}
